# ==============================================================================
# HERMES-OMNI ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Remote Inference Cluster (NVIDIA RTX 5090 32GB)
OLLAMA_REMOTE_URL=https://ollama-remote.your-tunnel.net
OLLAMA_MODEL_NAME=qwen3.8-pro
OLLAMA_REQUEST_TIMEOUT_SECONDS=600

# Local LLM Gateway & Concurrency
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
GATEWAY_API_KEY=omni-local
MAX_CONCURRENT_LLM_CALLS=1
GPU_LOCK_FILE=/tmp/omni_gpu.lock

# VRAM & Context Settings (RTX 5090 Tuned)
DEFAULT_NUM_CTX=32768
COUNCIL_NUM_CTX=65536
MAX_REFLEXION_TURNS=3

# Databases & Observability
DATABASE_URL=postgresql://omni_user:omni_pass@localhost:5432/omni_db
SQLITE_DB_PATH=./omni_memory.db
REDIS_URL=redis://localhost:6379/0

# Mobile Gateway (WhatsApp / Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
WHATSAPP_SESSION_PATH=./.whatsapp_session
WHATSAPP_ALLOWED_PHONE=

# Safety Gate Tiers
ENABLE_SAFETY_GATE=true
REQUIRE_HITL_ON_TIER3=true
